# ==========================================
# Acropolis LMS Credentials & Settings
# ==========================================
# Network choice: "internet" (Home: 47.29.0.163) or "campus" (College: 172.16.8.203)
LMS_NETWORK=internet

# Your student enrollment number in lowercase (e.g., 0827cs113112)
LMS_USERNAME=

# Your password (default: Student@123 or your updated password)
LMS_PASSWORD=Student@123

# ==========================================
# AI Provider Configuration (Choose Gemini or NVIDIA)
# ==========================================
# Options: "gemini" or "nvidia"
AI_PROVIDER=gemini

# Google Gemini Configuration
# Get free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.7-flash

# NVIDIA NIM Configuration (Alternative)
# Get free key at: https://build.nvidia.com
NVIDIA_API_KEY=
NVIDIA_MODEL=meta/llama-3.3-70b-instruct
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# ==========================================
# Browser & Automation Behavior
# ==========================================
# Set to true for silent background running, false to watch browser window
HEADLESS=false

# Auto submit quizzes once all questions are answered
AUTO_SUBMIT=true

# Human-like delay range between clicks (in seconds)
HUMAN_DELAY_MIN=1.0
HUMAN_DELAY_MAX=2.5
